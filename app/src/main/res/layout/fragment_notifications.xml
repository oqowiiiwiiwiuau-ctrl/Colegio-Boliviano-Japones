<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F5F5F5"
    tools:context=".ui.notifications.NotificationsFragment">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Título -->
        <TextView
            android:id="@+id/text_notifications_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Observaciones del Estudiante"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A2332"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresa el nombre del estudiante para ver sus observaciones"
            android:textSize="14sp"
            android:textColor="#6B7A8F"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Campo de búsqueda -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Estudiante:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A2332"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: ADUVIRI CHURA ARLIN LUCILA"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="@drawable/edittext_border" />

        <!-- Botón de búsqueda -->
        <Button
            android:id="@+id/btnBuscarObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 BUSCAR OBSERVACIONES"
            android:layout_marginTop="15dp"
            android:padding="14dp"
            android:backgroundTint="#FF6F00"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <!-- Nombre del estudiante -->
        <TextView
            android:id="@+id/textViewStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Estudiante:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A2332"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <!-- ScrollView para resultados -->
        <ScrollView
            android:id="@+id/scrollViewResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</ScrollView>