<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app">

    <!-- =========================================== -->
    <!-- ENCABEZADO CON INFORMACIÓN DEL MAESTRO      -->
    <!-- =========================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/curso_primero"
        android:elevation="8dp"
        android:padding="12dp">

        <!-- Primera fila: Curso y Gestión -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@android:color/white"
                android:contentDescription="Regresar" />

            <TextView
                android:id="@+id/tvTituloCurso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRIMERO C"
                android:textSize="22sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/tvGestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión 2026"
                android:textSize="14sp"
                android:background="@android:color/white"
                android:textColor="@color/curso_primero"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:backgroundTint="#FFFFFF"
                android:elevation="2dp" />
        </LinearLayout>

        <!-- Segunda fila: Maestro y Área -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMaestro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prof. Marcos Antonio Ezequiel Ramos Flores"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Área: Matemática"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:background="@color/color_secundario"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:elevation="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- =========================================== -->
    <!-- CONTENEDOR PRINCIPAL CON TABLAS             -->
    <!-- =========================================== -->
    <LinearLayout
        android:id="@+id/contenedorPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- TABLA FIJA: N° y NOMBRES -->
        <ScrollView
            android:id="@+id/scrollFijaVertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:background="@android:color/white">

            <TableLayout
                android:id="@+id/tablaFija"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="false" />
        </ScrollView>

        <!-- TABLA DE NOTAS CON SCROLL -->
        <HorizontalScrollView
            android:id="@+id/scrollHorizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="horizontal|vertical"
            android:background="@android:color/white">

            <ScrollView
                android:id="@+id/scrollVertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="vertical">

                <TableLayout
                    android:id="@+id/tablaNotas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="false" />
            </ScrollView>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>