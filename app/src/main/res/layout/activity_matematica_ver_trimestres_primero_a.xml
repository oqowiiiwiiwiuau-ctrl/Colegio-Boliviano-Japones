<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

  <!-- ===================================================== -->
  <!-- ENCABEZADO SUPERIOR (estilo Notion) -->
  <!-- ===================================================== -->
  <LinearLayout
      android:id="@+id/headerContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:paddingTop="28dp"
      android:paddingBottom="20dp"
      android:background="#FFFFFF">

    <!-- Emoji/ícono + Categoría -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📐  MATEMÁTICAS"
        android:textColor="#787774"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        android:textStyle="bold" />

    <!-- Título principal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Primero de Secundaria"
        android:textColor="#37352F"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión 2026  ·  Curso Primero C"
        android:textColor="#787774"
        android:textSize="15sp"
        android:layout_marginTop="6dp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E9E9E7"
        android:layout_marginTop="18dp" />

    <!-- Maestro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

      <TextView
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:gravity="center"
          android:text="👨‍🏫"
          android:textSize="16sp"
          android:background="@drawable/bg_icon_soft" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:layout_marginStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maestro"
            android:textColor="#9B9A97"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marco Antonio Exequiel Ramos Flores"
            android:textColor="#37352F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

      </LinearLayout>

    </LinearLayout>

  </LinearLayout>

  <!-- ===================================================== -->
  <!-- CONTENIDO SCROLLEABLE -->
  <!-- ===================================================== -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:clipToPadding="false"
      android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp">

      <!-- Etiqueta de sección -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="TRIMESTRES"
          android:textColor="#9B9A97"
          android:textSize="11sp"
          android:letterSpacing="0.08"
          android:textStyle="bold"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="12dp" />

      <!-- ============ PRIMER TRIMESTRE ============ -->
      <androidx.cardview.widget.CardView
          android:id="@+id/cardPrimerTrimestre"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?attr/selectableItemBackground"
          app:cardCornerRadius="12dp"
          app:cardElevation="0dp"
          app:cardBackgroundColor="#FFFFFF"
          app:strokeColor="#E9E9E7"
          app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

          <!-- Barra de acento -->
          <View
              android:layout_width="4dp"
              android:layout_height="44dp"
              android:background="#2563EB"
              android:layout_marginEnd="14dp" />

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Primer Trimestre"
                android:textColor="#37352F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver contenidos"
                android:textColor="#787774"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />

          </LinearLayout>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="#9B9A97"
              android:textSize="26sp" />

        </LinearLayout>

      </androidx.cardview.widget.CardView>

      <!-- ============ SEGUNDO TRIMESTRE ============ -->
      <androidx.cardview.widget.CardView
          android:id="@+id/cardSegundoTrimestre"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?attr/selectableItemBackground"
          app:cardCornerRadius="12dp"
          app:cardElevation="0dp"
          app:cardBackgroundColor="#FFFFFF"
          app:strokeColor="#E9E9E7"
          app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

          <View
              android:layout_width="4dp"
              android:layout_height="44dp"
              android:background="#059669"
              android:layout_marginEnd="14dp" />

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Segundo Trimestre"
                android:textColor="#37352F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver contenidos"
                android:textColor="#787774"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />

          </LinearLayout>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="#9B9A97"
              android:textSize="26sp" />

        </LinearLayout>

      </androidx.cardview.widget.CardView>

      <!-- ============ TERCER TRIMESTRE ============ -->
      <androidx.cardview.widget.CardView
          android:id="@+id/cardTercerTrimestre"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?attr/selectableItemBackground"
          app:cardCornerRadius="12dp"
          app:cardElevation="0dp"
          app:cardBackgroundColor="#FFFFFF"
          app:strokeColor="#E9E9E7"
          app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

          <View
              android:layout_width="4dp"
              android:layout_height="44dp"
              android:background="#D97706"
              android:layout_marginEnd="14dp" />

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tercer Trimestre"
                android:textColor="#37352F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver contenidos"
                android:textColor="#787774"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />

          </LinearLayout>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="#9B9A97"
              android:textSize="26sp" />

        </LinearLayout>

      </androidx.cardview.widget.CardView>

    </LinearLayout>

  </ScrollView>

  <!-- ===================================================== -->
  <!-- BOTÓN CENTRALIZADOR FIJO ABAJO (resaltado) -->
  <!-- ===================================================== -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="#FFFFFF"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:paddingTop="12dp"
      android:paddingBottom="20dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E9E9E7"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnCentralizador"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CENTRALIZADOR"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:backgroundTint="#7C3AED"
        android:elevation="4dp"
        app:cornerRadius="12dp" />

  </LinearLayout>

</LinearLayout>