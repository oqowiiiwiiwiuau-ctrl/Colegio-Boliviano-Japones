<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewParalelo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nombre del paralelo -->
        <TextView
            android:id="@+id/tvNombreParalelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Primero A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A2332" />

        <!-- Cantidad de estudiantes -->
        <TextView
            android:id="@+id/tvCantidadEstudiantes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 estudiantes"
            android:textSize="14sp"
            android:textColor="#6B7A8F"
            android:layout_marginTop="4dp" />

        <!-- Materias (chips) -->
        <LinearLayout
            android:id="@+id/layoutMaterias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>