<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAFAFA"
    tools:context=".ui.home.HomeFragment">

    <!-- Campo de Búsqueda de Nombre -->
    <EditText
        android:id="@+id/editTextNameSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Buscar nombre del estudiante"
        android:inputType="textPersonName"
        android:padding="16dp"
        android:textSize="18sp"
        android:drawableStart="@drawable/outline_ar_stickers_24"
        android:drawablePadding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>


    <View
        android:id="@+id/statusIndicator"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/status_indicator_gray"
        app:layout_constraintTop_toBottomOf="@id/editTextNameSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/textViewStatus"/>

    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Ingrese un nombre para verificar estado"
        android:textSize="20sp"
        android:textColor="#212121"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/statusIndicator"
        app:layout_constraintTop_toTopOf="@id/statusIndicator"
        app:layout_constraintBottom_toBottomOf="@id/statusIndicator"
        app:layout_constraintEnd_toEndOf="parent"/>


    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="36dp"
        android:background="#BDBDBD"
        app:layout_constraintTop_toBottomOf="@id/statusIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/textViewEntryTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hora de Entrada:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#424242"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/separator"/>

    <TextView
        android:id="@+id/textViewEntryTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textSize="18sp"
        android:textColor="#212121"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/textViewEntryTimeLabel"
        app:layout_constraintTop_toTopOf="@id/textViewEntryTimeLabel"/>


    <TextView
        android:id="@+id/textViewExitTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hora de Salida:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#424242"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewEntryTimeLabel"/>

    <TextView
        android:id="@+id/textViewExitTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textSize="18sp"
        android:textColor="#212121"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/textViewExitTimeLabel"
        app:layout_constraintTop_toTopOf="@id/textViewExitTimeLabel"/>

</androidx.constraintlayout.widget.ConstraintLayout>
