<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA"
    tools:context=".ui.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ENCABEZADO -->
        <TextView
            android:id="@+id/textViewHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="📋 Asistencia de mis hijos"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A2332"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- SUBTÍTULO -->
        <TextView
            android:id="@+id/textViewSubHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Estado de asistencia del día"
            android:textSize="14sp"
            android:textColor="#6B7A8F"
            app:layout_constraintTop_toBottomOf="@id/textViewHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

        <!-- FECHA -->
        <TextView
            android:id="@+id/textViewDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 2026-09-15"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#6B7A8F"
            app:layout_constraintTop_toBottomOf="@id/textViewSubHeader"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <!-- ESTADO GENERAL -->
        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Cargando..."
            android:textSize="14sp"
            android:textColor="#6B7A8F"
            app:layout_constraintTop_toBottomOf="@id/textViewDate"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- NOMBRE DEL APODERADO (oculto por defecto, se llena en código) -->
        <TextView
            android:id="@+id/textViewStudentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A2332"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/textViewDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textViewStatus"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp" />

        <!-- CONTENEDOR DINÁMICO DE HIJOS -->
        <LinearLayout
            android:id="@+id/contenedorHijos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/textViewStudentName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>